{
  "expo": {
    "name": "MrDownload",
    "slug": "mrdownload",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0818"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mrdownload.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0818"
      },
      "package": "com.mrdownload.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "youtube.com" },
            { "scheme": "https", "host": "youtu.be" },
            { "scheme": "https", "host": "tiktok.com" },
            { "scheme": "https", "host": "instagram.com" },
            { "scheme": "https", "host": "facebook.com" },
            { "scheme": "https", "host": "twitter.com" },
            { "scheme": "https", "host": "x.com" },
            { "scheme": "https", "host": "vimeo.com" },
            { "scheme": "https", "host": "xhamster.com" },
            { "scheme": "https", "host": "xnxx.com" }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "MrDownload needs access to your media gallery to download and save videos.",
          "savePhotosPermission": "MrDownload needs permission to save videos directly into your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "scheme": "mrdownload",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f047fc41-cedb-4789-997a-b3d63c0612e7"
      }
    }
  }
}
